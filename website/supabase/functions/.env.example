# Cloudflare's official test secret. Pair only with the test sitekey in environment.development.ts.
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CLOUDFLARE_TURNSTILE_EXPECTED_HOSTNAMES=localhost,tailwind.localhost,secured.localhost,test.localhost,www.localhost
PUBLIC_FORM_ALLOWED_ORIGINS=http://localhost:4200,http://tailwind.localhost:4200,http://secured.localhost:4200,http://test.localhost:4200,http://www.localhost:4200
# Replace locally with a random value of at least 32 characters before running rate-limit checks.
PUBLIC_FORM_RATE_LIMIT_HASH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
